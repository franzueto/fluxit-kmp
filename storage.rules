rules_version = '2';

// FluxIt baseline Cloud Storage Security Rules (FB-005, PLAN-002).
//
// Security model: deny by default, authenticated, owner-only.
//   * Only the single object path below is matched; every other object path is
//     denied for every caller, authenticated or not. There is no `{allPaths=**}`
//     catch-all.
//   * The one `allow` pair is guarded by `isOwner(uid)`, which requires BOTH a
//     signed-in caller AND that the caller's uid equals the `{uid}` path
//     segment.
//
// Object path per FIREBASE_MIGRATION_PLAN.md "Proposed Firebase model":
//   users/{uid}/items/{itemId}/{photoId}
// This is matched at exactly that depth, so an object stored one segment
// shallower or deeper is denied. `photoRef` persisted on an item document must
// therefore be an object path of exactly this shape.
//
// Scope (PLAN-002): Phase 0 BASELINE only. Content-type, size-limit and
// metadata validation, and orphan-photo lifecycle enforcement, are Phase 6
// (FB-601/FB-602) and are deliberately NOT implemented here.

service firebase.storage {
  match /b/{bucket}/o {

    // Signed in AND the owner of this user-scoped object path.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/items/{itemId}/{photoId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }
  }
}
