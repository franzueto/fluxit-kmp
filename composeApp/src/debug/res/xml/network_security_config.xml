<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  The Firebase emulator suite speaks plain HTTP, and Android blocks cleartext by
  default, so a debug build that talks to the emulator fails with
  "Cleartext HTTP traffic to 10.0.2.2 not permitted" before any request is sent.
  Only the loopback aliases used by the emulator suite are exempted, and only in the
  debug variant: the release manifest is untouched, so shipped builds keep the
  platform default of cleartext-denied.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The Android emulator's alias for the development machine's loopback. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- `adb reverse` / a locally hosted emulator suite. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
